# Watchlist Next.js local environment example.
# Copy this file to `.env.local` and fill real values locally.

# Server configuration
AUTH_SECRET=change-this-to-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL connection string for Prisma.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DB_POOL_MAX=1
DB_POOL_IDLE_TIMEOUT_MS=1000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Media APIs
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
OMDB_API_KEY=

# Registration security
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Keep false by default. Set true only when you want to test Turnstile on localhost.
TURNSTILE_ENABLE_LOCAL=false
REGISTRATION_RATE_LIMIT=8
REGISTRATION_RATE_WINDOW_MS=900000
REGISTRATION_MAX_ACCOUNTS_PER_IP=5

# Supabase Storage for profile avatars and covers.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=watchlist-media
# Set to true only when Supabase Image Transformations are enabled for the project.
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=false

# Supabase Auth SMTP through Resend.
# SUPABASE_ACCESS_TOKEN is a Supabase personal access token from Account > Access Tokens.
# RESEND_API_KEY must be a valid Resend API key; do not commit it.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
RESEND_API_KEY=
SUPABASE_SMTP_FROM_EMAIL=no-reply@example.com
SUPABASE_SMTP_SENDER_NAME=Watchlist
SUPABASE_SMTP_PORT=587
